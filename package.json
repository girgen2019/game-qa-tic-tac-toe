{
  "name": "game-qa-tic-tac-toe",
  "version": "1.0.0",
  "private": true,
  "description": "Game QA pet project: Tic-Tac-Toe with test documentation and Playwright autotests",
  "scripts": {
    "start": "http-server . -p 8080 -c-1 --silent",
    "test": "playwright test",
    "test:desktop": "playwright test --project=desktop-chrome",
    "test:mobile": "playwright test --project=mobile-chrome",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "http-server": "14.1.1"
  }
}
